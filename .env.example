# Public origin; HTTPS for deployed installations.
APP_URL=http://localhost:3100
ADMIN_EMAILS=admin@example.com
BETTER_AUTH_SECRET=
# Accepted only by next dev when APP_URL is a loopback host. Compose forces false.
DEV_AUTH_BYPASS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Luoda <reviews@example.com>

POSTGRES_PASSWORD=
# For local Node development. Compose supplies its own internal DATABASE_URL.
DATABASE_URL=postgresql://luoda:replace-me@localhost:55439/luoda

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

NAN_BASE_URL=https://api.nan.builders/v1
NAN_API_KEY=
NAN_MODEL=

SCANNER_TOKEN=
SCANNER_URL=http://localhost:18080

# Dokploy override: set to the application's hostname, without https://.
APP_DOMAIN=reviews.example.com
