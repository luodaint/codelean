# Public origin; HTTPS for deployed installations.
APP_URL=http://localhost:3100
# Anyone with a verified GitHub identity can sign up. Use restricted for a private pilot.
SIGNUP_MODE=open
# Used only in restricted mode and once when migrating an existing private workspace.
ADMIN_EMAILS=
BETTER_AUTH_SECRET=
# Accepted only by next dev when APP_URL is a loopback host. Compose forces false.
DEV_AUTH_BYPASS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Codelean <reviews@codelean.dev>

POSTGRES_USER=codelean
POSTGRES_DB=codelean
POSTGRES_PASSWORD=
# For local Node development. Compose supplies its own internal DATABASE_URL.
DATABASE_URL=postgresql://codelean:replace-me@localhost:55439/codelean

# GitHub App user authorization (Client ID is different from the numeric App ID).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

NAN_BASE_URL=https://api.nan.builders/v1
NAN_API_KEY=
NAN_MODEL=
# Optional fallback for NaN reasoning-only cutoffs; e.g. glm5.3-flash.
NAN_FALLBACK_MODEL=

SCANNER_TOKEN=
SCANNER_URL=http://localhost:18080

# Billing is enforced unless explicitly disabled for local development/observation.
BILLING_ENABLED=true
# Set false for live production billing, with matching live Creem keys/products.
# Keep true for sandbox validation; verify a sandbox invoice before switching.
CREEM_TEST_MODE=true
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PLAN_PRODUCT_ID=
CREEM_TOKEN_PRODUCT_ID=
CREEM_METER_ID=
# Shared provider quota. Lower this to reserve capacity for your other projects.
BILLING_PROVIDER_TOKEN_BUDGET=3000000000
# Optional ISO instant at the start of the provider's actual billing period.
# If blank, use the current UTC calendar month. Update when the provider renews.
BILLING_PROVIDER_PERIOD_START=

# Dokploy override: set to the application's hostname, without https://.
APP_DOMAIN=codelean.dev
